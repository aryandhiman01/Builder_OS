generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String?
  emailVerified DateTime?
  image         String?
  settings      String?   @db.Text
  createdAt     DateTime  @default(now())
  accounts      Account[]
  projects      Project[]
  roadmaps      Roadmap[]
  sessions      Session[]

  // Team collaboration
  projectMemberships ProjectMember[]
  sentInvitations    ProjectInvitation[] @relation("InvitedBy")

  aiConversations AIConversation[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String   @default("SaaS")
  color       String   @default("#FFFFFF")
  status      String   @default("Planning")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String

  user User @relation(fields: [userId], references: [id])

  ideas Idea[]
  tasks Task[]

  researches Research[]

  prds PRD[]

  roadmaps Roadmap[]

  architectures Architecture[]

  documents Document[]

  // Team collaboration
  members     ProjectMember[]
  invitations ProjectInvitation[]
}

model Idea {
  id          String   @id @default(cuid())
  title       String
  description String?
  projectId   String
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Task {
  id             String    @id @default(cuid())
  title          String
  description    String?
  status         String    @default("todo")
  priority       String    @default("medium")
  dueDate        DateTime?
  estimatedHours Float?
  tags           String?   // JSON: string[]
  subtasks       String?   // JSON: { id: string; title: string; completed: boolean }[]
  order          Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Research {
  id             String   @id @default(cuid())
  title          String
  prompt         String   @db.Text
  content        String   @db.Text
  model          String?
  tokens         Int?
  generationTime Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  projectId      String
  prd            PRD?
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model PRD {
  id     String @id @default(cuid())
  title  String
  prompt String @db.Text

  content        String    @db.Text
  model          String?
  tokens         Int?
  generationTime Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  projectId      String
  researchId     String?   @unique
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  research       Research? @relation(fields: [researchId], references: [id], onDelete: Cascade)
  roadmap        Roadmap?

  @@index([projectId])
}

model Roadmap {
  id String @id @default(cuid())

  title       String
  description String?
  type        String  @default("STANDALONE") // STANDALONE | PROJECT
  status      String  @default("PLANNING")   // PLANNING | COMPLETED | ARCHIVED
  progress    Float   @default(0)

  prompt String? @db.Text
  content String? @db.Text

  estimatedDuration String?
  resources         String? @db.Text // JSON string
  notes             String? @db.Text

  model          String?
  tokens         Int?
  generationTime Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  prdId String? @unique
  prd   PRD?    @relation(fields: [prdId], references: [id], onDelete: Cascade)

  architecture Architecture?

  milestones RoadmapMilestone[]

  @@index([userId])
  @@index([projectId])
}

model RoadmapMilestone {
  id          String   @id @default(cuid())
  roadmapId   String
  title       String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roadmap Roadmap       @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  steps   RoadmapStep[]

  @@index([roadmapId])
}

model RoadmapStep {
  id             String   @id @default(cuid())
  milestoneId    String
  title          String
  description    String?
  completed      Boolean  @default(false)
  estimatedHours Float?
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  milestone RoadmapMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([milestoneId])
}

model Architecture {
  id String @id @default(cuid())

  title String

  prompt String @db.Text

  content String @db.Text

  model String?

  tokens Int?

  generationTime Int?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  projectId String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // NULL => Custom Architecture
  roadmapId String? @unique

  roadmap Roadmap? @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Document {
  id             String   @id @default(cuid())

  title          String
  type           String

  prompt         String   @db.Text
  content        String   @db.Text

  model          String?
  tokens         Int?
  generationTime Int?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  projectId      String
  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ─── Team Collaboration ────────────────────────────────────────────────────────

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("MEMBER") // "OWNER" | "MEMBER"
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model ProjectInvitation {
  id          String   @id @default(cuid())
  projectId   String
  email       String
  token       String   @unique
  status      String   @default("PENDING") // "PENDING" | "ACCEPTED" | "EXPIRED"
  invitedById String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([token])
  @@index([email])
}

model AIConversation {
  id String @id @default(cuid())

  title String

  // JSON-stringified array of { role: "user" | "assistant", content: string }
  messages String @db.Text

  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  status    String   @default("PENDING") // "PENDING" | "RESOLVED"
  createdAt DateTime @default(now())

  @@index([email])
}